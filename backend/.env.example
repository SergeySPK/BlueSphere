# ============================================================
# PostgreSQL
# ============================================================

# Имя пользователя PostgreSQL.
POSTGRES_USER=bluesphere

# Пароль пользователя PostgreSQL.
# Замени на собственный надёжный пароль. Если в пароле есть специальные символы (@, #, /, : и другие), их нужно URL-кодировать. Например, @ → %40.
POSTGRES_PASSWORD=change_me_to_a_secure_password

# Название базы данных.
POSTGRES_DB=bluesphere

# Строка подключения backend-контейнеров к PostgreSQL.
# Хост postgres — это имя сервиса в docker-compose.yml.
DATABASE_URL=postgresql+psycopg://bluesphere:change_me_to_a_secure_password@postgres:5432/bluesphere


# ============================================================
# API и авторизация
# ============================================================

# Секретный ключ для подписи и проверки JWT.
# Используй длинную случайную строку.
JWT_SECRET_KEY=replace_with_long_random_secret

# Разрешённые адреса frontend через запятую.
# Для локального запуска Flutter Web можно оставить этот адрес.
FRONTEND_URL=http://localhost:8080


# ============================================================
# MAX
# ============================================================

# Токен MAX-бота.
# Получается при создании бота в MAX.
BOT_TOKEN=replace_with_max_bot_token


# ============================================================
# Режим работы
# ============================================================

# DEMO_MODE:
# true  — демонстрационный режим;
# false — обычный режим.
DEMO_MODE=false

# SEND_NOTIFICATIONS:
# true  — разрешена реальная отправка уведомлений MAX;
# false — отправка отключена.
#
# Для первоначального запуска рекомендуется false.
SEND_NOTIFICATIONS=false


# ============================================================
# AI
# ============================================================

# Основной AI-провайдер.
# Все три значения должны быть заполнены для его активации.
# Примеры BASE_URL зависят от используемого провайдера.
AI_BASE_URL=
AI_TOKEN=
AI_MODEL=

# Резервный AI-провайдер.
# Необязателен. Если не используется — оставить пустым.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_TOKEN=
AI_FALLBACK_MODEL=

# Таймаут запроса к AI в секундах.
AI_TIMEOUT_SECONDS=60

# Максимальное количество токенов в ответе AI.
AI_MAX_OUTPUT_TOKENS=4000
